{
  "openapi": "3.1.0",
  "info": {
    "title": "KANI Private Settlement Network API",
    "version": "0.1.0",
    "description": "Phase 1 sandbox-only API for the KANI private settlement network. This contract is for internal simulation only and does not represent real-value payment services."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Docker Desktop sandbox"
    },
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local IPv4 sandbox"
    }
  ],
  "security": [
    {
      "KaniInstitutionId": [],
      "KaniApiKey": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Read sandbox service health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Read the Phase 1 OpenAPI contract",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/vnd.oai.openapi+json;version=3.1": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments": {
      "post": {
        "summary": "Submit a sandbox transfer payment",
        "description": "Creates or returns an idempotent sandbox transfer payment. The caller must control the `from` account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/iso20022/pacs008": {
      "post": {
        "summary": "Submit a sandbox ISO 20022 pacs.008 payment",
        "description": "Parses a single-credit-transfer pacs.008 XML document and submits it through the sandbox payment ledger. Amounts are KANI minor units and the caller must control the debtor account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "string",
                "description": "pacs.008 XML document"
              }
            },
            "text/xml": {
              "schema": {
                "type": "string",
                "description": "pacs.008 XML document"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ISO 20022 payment accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IsoPacs008PaymentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/iso20022/pacs002/{payment_id}": {
      "get": {
        "summary": "Read ISO 20022 pacs.002 payment status",
        "description": "Returns a sandbox pacs.002 XML status report for a payment visible to the requesting institution.",
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "pacs.002 status report",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string",
                  "description": "pacs.002 XML document"
                }
              },
              "text/xml": {
                "schema": {
                  "type": "string",
                  "description": "pacs.002 XML document"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/iso20022/camt053/accounts/{account_id}": {
      "get": {
        "summary": "Read ISO 20022 camt.053 account statement",
        "description": "Returns a sandbox camt.053 XML account statement for one account and asset. Visible only to the institution that owns the account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "name": "asset",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9_]{3,32}$"
            },
            "examples": {
              "testCad": {
                "value": "KCAD_TEST"
              }
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "camt.053 account statement",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string",
                  "description": "camt.053 XML document"
                }
              },
              "text/xml": {
                "schema": {
                  "type": "string",
                  "description": "camt.053 XML document"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "summary": "Read a payment by id",
        "description": "Visible to the sending or receiving institution.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "summary": "Read account inventory",
        "description": "Sandbox admin credentials are required.",
        "responses": {
          "200": {
            "description": "Account inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/accounts/{account_id}/balances/{asset}": {
      "get": {
        "summary": "Read an account asset balance",
        "description": "Visible only to the institution that owns the account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/Asset"
          }
        ],
        "responses": {
          "200": {
            "description": "Account balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/assets/{asset}/issued": {
      "get": {
        "summary": "Read issued asset supply",
        "description": "Sandbox admin credentials are required.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Asset"
          }
        ],
        "responses": {
          "200": {
            "description": "Issued asset supply",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/transactions/pending": {
      "get": {
        "summary": "Read pending transactions",
        "description": "Sandbox admin credentials are required.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated pending transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedTransactionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/blocks": {
      "get": {
        "summary": "Read finalized blocks",
        "description": "Sandbox admin credentials are required. Results are paginated and returned newest to oldest in PostgreSQL mode.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated finalized blocks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedBlockResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/blocks/latest": {
      "get": {
        "summary": "Read the latest finalized block",
        "description": "Sandbox admin credentials are required.",
        "responses": {
          "200": {
            "description": "Latest finalized block",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Block"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/audit-events": {
      "get": {
        "summary": "Read audit events",
        "description": "Sandbox admin credentials are required. Supports server-side filtering and pagination.",
        "parameters": [
          {
            "$ref": "#/components/parameters/EventType"
          },
          {
            "$ref": "#/components/parameters/Decision"
          },
          {
            "$ref": "#/components/parameters/InstitutionIdQuery"
          },
          {
            "$ref": "#/components/parameters/CreatedFrom"
          },
          {
            "$ref": "#/components/parameters/CreatedTo"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAuditEventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/reports/settlement-summary": {
      "get": {
        "summary": "Read settlement summary report",
        "description": "Sandbox admin credentials are required. Summarizes finalized sandbox blocks by transaction kind and asset.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CreatedFrom"
          },
          {
            "$ref": "#/components/parameters/CreatedTo"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Settlement summary report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementSummaryReport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/reports/compliance-decisions": {
      "get": {
        "summary": "Read compliance decision report",
        "description": "Sandbox admin credentials are required. Groups COMPLIANCE_DECISION audit events by decision, rule, and institution.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CreatedFrom"
          },
          {
            "$ref": "#/components/parameters/CreatedTo"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Compliance decision report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComplianceDecisionReport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/reports/validator-finality": {
      "get": {
        "summary": "Read validator finality report",
        "description": "Sandbox admin credentials are required. Summarizes validator block production, finality votes, and 2/3 threshold coverage.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CreatedFrom"
          },
          {
            "$ref": "#/components/parameters/CreatedTo"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Validator finality report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatorFinalityReport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/validators": {
      "get": {
        "summary": "Read validator status",
        "description": "Sandbox admin credentials are required.",
        "responses": {
          "200": {
            "description": "Validators",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ValidatorResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v1/sandbox/mint": {
      "post": {
        "summary": "Mint sandbox test value",
        "description": "Sandbox treasury credentials are required. This operation is simulation-only and does not create real redeemable value.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SandboxMintRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mint payment accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "KaniInstitutionId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kani-institution-id"
      },
      "KaniApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kani-api-key"
      }
    },
    "parameters": {
      "PaymentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AccountId": {
        "name": "account_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,32}$"
        },
        "examples": {
          "corpA": {
            "value": "CORP_A"
          }
        }
      },
      "Asset": {
        "name": "asset",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "examples": {
          "testCad": {
            "value": "KCAD_TEST"
          }
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "EventType": {
        "name": "event_type",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Decision": {
        "name": "decision",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "DENIED"
          ]
        }
      },
      "InstitutionIdQuery": {
        "name": "institution_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "CreatedFrom": {
        "name": "created_from",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "CreatedTo": {
        "name": "created_to",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid sandbox credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Credential is not authorized for the requested resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Internal": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "service",
          "status",
          "environment",
          "real_value",
          "redeemable"
        ],
        "properties": {
          "service": {
            "type": "string",
            "const": "kani-api"
          },
          "status": {
            "type": "string",
            "const": "ok"
          },
          "environment": {
            "type": "string",
            "const": "SANDBOX"
          },
          "real_value": {
            "type": "boolean",
            "const": false
          },
          "redeemable": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "from",
          "to",
          "asset",
          "amount"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
