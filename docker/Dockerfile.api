FROM rust:1.76-bookworm AS builder

WORKDIR /app
COPY . .
RUN cargo build --release -p kani-api

FROM debian:bookworm-slim

RUN useradd --create-home --shell /usr/sbin/nologin kani
WORKDIR /app
COPY --from=builder /app/target/release/kani-api /usr/local/bin/kani-api
USER kani

ENV KANI_API_ADDR=0.0.0.0:8080
EXPOSE 8080

CMD ["kani-api"]
