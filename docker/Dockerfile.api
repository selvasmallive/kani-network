FROM rust:1-bookworm AS builder

WORKDIR /app
COPY . .
RUN cargo build --release -p kani-api -p kani-node

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /usr/sbin/nologin kani
WORKDIR /app
COPY --from=builder /app/target/release/kani-api /usr/local/bin/kani-api
COPY --from=builder /app/target/release/kani-cost-guard /usr/local/bin/kani-cost-guard
COPY --from=builder /app/target/release/kani-node /usr/local/bin/kani-node
COPY --from=builder /app/migrations ./migrations
USER kani

ENV KANI_API_ADDR=0.0.0.0:8080
EXPOSE 8080

CMD ["kani-api"]
